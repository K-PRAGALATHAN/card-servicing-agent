# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development

# ── API service (Node.js / Fastify) ──────────────────
PORT=4000
HOST=0.0.0.0

# ── Agent service (FastAPI) ───────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=card
POSTGRES_PASSWORD=card
POSTGRES_DB=card_servicing
# Host port for the postgres container (default 5433 to avoid clashing with
# other local Postgres on 5432). Container-internal port stays 5432.
POSTGRES_HOST_PORT=5433
# For host-based (non-docker) local dev, connect on the host port above:
DATABASE_URL=postgres://card:card@localhost:5433/card_servicing

# ── MongoDB ───────────────────────────────────────────
MONGO_USER=card
MONGO_PASSWORD=card
MONGO_URL=mongodb://card:card@localhost:27017

# ── LLM (Phase 2) ─────────────────────────────────────
# Provider precedence: Anthropic > OpenAI > rule-based stand-in.
# Leave both keys empty to run the deterministic stand-in (no external calls).
# Get a Claude key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── App ──────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development

# ── API service (Node.js / Fastify) ──────────────────
PORT=4000
HOST=0.0.0.0

# ── Agent service (FastAPI) ───────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=card
POSTGRES_PASSWORD=card
POSTGRES_DB=card_servicing
# Host port for the postgres container (default 5433 to avoid clashing with
# other local Postgres on 5432). Container-internal port stays 5432.
POSTGRES_HOST_PORT=5433
# For host-based (non-docker) local dev, connect on the host port above:
DATABASE_URL=postgres://card:card@localhost:5433/card_servicing

# ── MongoDB ───────────────────────────────────────────
MONGO_USER=card
MONGO_PASSWORD=card
MONGO_URL=mongodb://card:card@localhost:27017

# ── Auth (shared between the API and the agent) ───────
# The agent validates the same access tokens the API issues.
JWT_SECRET=dev-secret-change-me
# Staff key for the auditor console (X-Auditor-Key header).
AUDITOR_KEY=audit-dev-key

# ── LLM: OpenRouter (single provider — chat + STT + TTS) ──
# Required. The agent has no fallback; a missing key fails fast.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
OPENROUTER_TTS_VOICE=alloy
